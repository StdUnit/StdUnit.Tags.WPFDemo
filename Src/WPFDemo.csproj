<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StdUnit.Tags" Version="1.0.0" />
    <PackageReference Include="StdUnit.Tags.BlazorLib.Core" Version="1.0.0" />
	<PackageReference Include="StdUnit.Tags.S7" Version="1.0.0" />
    <PackageReference Include="StdUnit.Tags.ComScanner" Version="1.0.0" />
    <PackageReference Include="StdUnit.Tags.Core" Version="1.0.0" />
    <PackageReference Include="StdUnit.Tags.McpServer" Version="1.0.0" />
    <PackageReference Include="StdUnit.Tags.R3Extensions" Version="1.0.0" />
	  
    <PackageReference Include="R3Extensions.WPF" Version="1.3.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Tags\index.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
